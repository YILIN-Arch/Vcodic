/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://*.supabase.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=300

/app.js
  Cache-Control: public, max-age=300

/submit.js
  Cache-Control: public, max-age=300

/site-config.js
  Cache-Control: public, max-age=300

/favicon.svg
  Cache-Control: public, max-age=86400

/social-card.svg
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=300
